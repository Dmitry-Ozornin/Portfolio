generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(cuid())
  login    String   @unique
  password String
  role     UserRole

  @@map("users")
}

enum UserRole {
  ADMIN
  WORKER
  MANAGER
}
